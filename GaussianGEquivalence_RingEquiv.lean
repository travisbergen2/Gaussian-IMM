import Mathlib.NumberTheory.SumTwoSquares
import Mathlib.Algebra.Ring.MinimalAxioms
import Mathlib.Tactic

/-!
# The coordinate bridge from Travis's `G` to `GaussianInt`

This file deliberately preserves the original, from-scratch `G` structure.
It constructs a genuine `CommRing` structure on the original `G`, then builds a
`RingEquiv` to Mathlib's `GaussianInt`. It also records the quarter-turn
action generated by multiplication by `i`.

The file does not replace `G` with `GaussianInt`, and it makes no claims about
Dirichlet L-functions or Dedekind zeta functions.
-/

-- Travis's original Gaussian-integer structure and operations.
@[ext] structure G where
  re : Int
  im : Int
  deriving DecidableEq, Repr

instance : Add G := ⟨fun x y => ⟨x.re + y.re, x.im + y.im⟩⟩
instance : Sub G := ⟨fun x y => ⟨x.re - y.re, x.im - y.im⟩⟩
instance : Mul G := ⟨fun x y => ⟨x.re * y.re - x.im * y.im,
  x.re * y.im + x.im * y.re⟩⟩

/-- Coordinate expansion of addition in the original `G`. -/
@[simp] theorem G.mk_add_mk (a b c d : Int) :
    (⟨a, b⟩ : G) + ⟨c, d⟩ = ⟨a + c, b + d⟩ := rfl

/-- Coordinate expansion of multiplication in the original `G`. -/
@[simp] theorem G.mk_mul_mk (a b c d : Int) :
    (⟨a, b⟩ : G) * ⟨c, d⟩ = ⟨a * c - b * d, a * d + b * c⟩ := rfl


-- The additive and multiplicative identities and additive inverse.
-- Numerals are supplied by the ring structure below, rather than by a
-- separate `OfNat` instance.
instance : Zero G := ⟨⟨0, 0⟩⟩
instance : One G := ⟨⟨1, 0⟩⟩
instance : Neg G := ⟨fun z => ⟨-z.re, -z.im⟩⟩

@[simp] theorem G.zero_re : (0 : G).re = 0 := rfl
@[simp] theorem G.zero_im : (0 : G).im = 0 := rfl
@[simp] theorem G.one_re : (1 : G).re = 1 := rfl
@[simp] theorem G.one_im : (1 : G).im = 0 := rfl
@[simp] theorem G.neg_re (z : G) : (-z).re = -z.re := rfl
@[simp] theorem G.neg_im (z : G) : (-z).im = -z.im := rfl
@[simp] theorem G.add_re (x y : G) : (x + y).re = x.re + y.re := rfl
@[simp] theorem G.add_im (x y : G) : (x + y).im = x.im + y.im := rfl
@[simp] theorem G.mul_re (x y : G) : (x * y).re = x.re * y.re - x.im * y.im := rfl
@[simp] theorem G.mul_im (x y : G) : (x * y).im = x.re * y.im + x.im * y.re := rfl

/--
The original coordinate operations on `G` satisfy the commutative-ring laws.
This equips the existing type with a ring structure without changing its
underlying representation or its definitions of addition and multiplication.
-/
instance : CommRing G :=
  CommRing.ofMinimalAxioms
    (by
      intro a b c
      cases a with
      | mk a₁ a₂ =>
        cases b with
        | mk b₁ b₂ =>
          cases c with
          | mk c₁ c₂ =>
            ext <;> simp [G.mk_add_mk] <;> ring)
    (by
      intro a
      cases a with
      | mk a b =>
        ext <;> simp [G.mk_add_mk])
    (by
      intro a
      cases a with
      | mk a b =>
        ext <;> simp [G.mk_add_mk])
    (by
      intro a b c
      cases a with
      | mk a₁ a₂ =>
        cases b with
        | mk b₁ b₂ =>
          cases c with
          | mk c₁ c₂ =>
            ext <;> simp [G.mk_mul_mk, G.mk_add_mk] <;> ring)
    (by
      intro a b
      cases a with
      | mk a₁ a₂ =>
        cases b with
        | mk b₁ b₂ =>
          ext <;> simp [G.mk_mul_mk] <;> ring)
    (by
      intro a
      cases a with
      | mk a b =>
        ext <;> simp [G.mk_mul_mk])
    (by
      intro a b c
      cases a with
      | mk a₁ a₂ =>
        cases b with
        | mk b₁ b₂ =>
          cases c with
          | mk c₁ c₂ =>
            ext <;> simp [G.mk_mul_mk, G.mk_add_mk] <;> ring)

def i : G := ⟨0, 1⟩
def negi : G := ⟨0, -1⟩

def conjG (z : G) : G := ⟨z.re, -z.im⟩

/-- The coordinate map from Travis's `G` to Mathlib's Gaussian integers. -/
def G.toGaussianInt (z : G) : GaussianInt := ⟨z.re, z.im⟩

/-- The coordinate map is injective. -/
theorem G.toGaussianInt_injective : Function.Injective G.toGaussianInt := by
  intro x y h
  cases x with
  | mk xr xi =>
    cases y with
    | mk yr yi =>
      simp [G.toGaussianInt] at h
      rcases h with ⟨hRe, hIm⟩
      subst yr
      subst yi
      rfl

/-- Every Mathlib Gaussian integer has a preimage in `G`. -/
theorem G.toGaussianInt_surjective : Function.Surjective G.toGaussianInt := by
  intro z
  refine ⟨⟨z.re, z.im⟩, ?_⟩
  cases z
  rfl

/-- The coordinate map preserves addition. -/
theorem G.toGaussianInt_add (x y : G) :
    G.toGaussianInt (x + y) = G.toGaussianInt x + G.toGaussianInt y := by
  cases x with
  | mk a b =>
    cases y with
    | mk c d =>
      ext <;> simp [G.toGaussianInt, G.mk_add_mk]

/-- The coordinate map preserves multiplication. -/
theorem G.toGaussianInt_mul (x y : G) :
    G.toGaussianInt (x * y) = G.toGaussianInt x * G.toGaussianInt y := by
  cases x with
  | mk a b =>
    cases y with
    | mk c d =>
      ext <;> simp [G.toGaussianInt, G.mk_mul_mk] <;> ring


/-- The coordinate map as a genuine ring homomorphism. -/
def G.toGaussianIntHom : G →+* GaussianInt where
  toFun := G.toGaussianInt
  map_one' := by
    ext <;> rfl
  map_mul' := G.toGaussianInt_mul
  map_zero' := by
    ext <;> rfl
  map_add' := G.toGaussianInt_add

/-- The coordinate map is bijective. -/
theorem G.toGaussianInt_bijective :
    Function.Bijective G.toGaussianIntHom := by
  constructor
  · exact G.toGaussianInt_injective
  · exact G.toGaussianInt_surjective

/--
A genuine ring equivalence between the original coordinate type `G` and
Mathlib's Gaussian integers.  The original `G` representation is retained.
-/
noncomputable def G.ringEquivGaussianInt : G ≃+* GaussianInt :=
  RingEquiv.ofBijective G.toGaussianIntHom G.toGaussianInt_bijective

/-- The integer norm computed in `G`. -/
def G.norm (z : G) : Int := z.re ^ 2 + z.im ^ 2

/-- The norm in `G` agrees with Mathlib's Gaussian norm. -/
theorem G.toGaussianInt_norm (z : G) :
    Zsqrtd.norm (G.toGaussianInt z) = G.norm z := by
  cases z with
  | mk a b =>
    simp [G.toGaussianInt, G.norm, Zsqrtd.norm_def]
    ring

/-- One quarter-turn: multiplication by `i` sends `(a,b)` to `(-b,a)`. -/
def G.rotate90 (z : G) : G := z * i

theorem G.rotate90_coordinates (a b : Int) :
    G.rotate90 ⟨a, b⟩ = ⟨-b, a⟩ := by
  simp [G.rotate90, i]

/-- Two quarter-turns: multiplication by `i² = -1`. -/
def G.rotate180 (z : G) : G := G.rotate90 (G.rotate90 z)

theorem G.rotate180_coordinates (a b : Int) :
    G.rotate180 ⟨a, b⟩ = ⟨-a, -b⟩ := by
  simp [G.rotate180, G.rotate90, i]

/-- Three quarter-turns: multiplication by `i³ = -i`. -/
def G.rotate270 (z : G) : G := G.rotate90 (G.rotate180 z)

theorem G.rotate270_coordinates (a b : Int) :
    G.rotate270 ⟨a, b⟩ = ⟨b, -a⟩ := by
  simp [G.rotate270, G.rotate180, G.rotate90, i]

/-- Four quarter-turns return every Gaussian integer to itself. -/
def G.rotate360 (z : G) : G := G.rotate90 (G.rotate270 z)

theorem G.rotate360_eq_self (z : G) : G.rotate360 z = z := by
  cases z with
  | mk a b =>
    simp [G.rotate360, G.rotate270, G.rotate180, G.rotate90, i]

/-- The four powers of `i`, represented as elements of `G`. -/
def G.iPow0 : G := ⟨1, 0⟩
def G.iPow1 : G := i
def G.iPow2 : G := ⟨-1, 0⟩
def G.iPow3 : G := negi

theorem G.iPow0_eq_one : G.iPow0 = (1 : G) := rfl
theorem G.iPow1_eq_i : G.iPow1 = i := by rfl
theorem G.iPow2_eq_neg_one : G.iPow2 = ⟨-1, 0⟩ := by rfl
theorem G.iPow3_eq_negi : G.iPow3 = negi := by rfl

/-- The trace readout: the real coordinate of `z + conjugate(z)`. -/
def G.trace (z : G) : Int := (z + conjG z).re

/-- Conjugation leaves the trace unchanged. -/
theorem G.trace_conj (z : G) : G.trace (conjG z) = G.trace z := by
  cases z with
  | mk a b =>
    rfl

/-- Conjugation reverses the imaginary coordinate. -/
theorem G.conj_im_neg (z : G) : (conjG z).im = -z.im := by
  rfl

/-- Conjugation leaves the norm unchanged. -/
theorem G.norm_conj (z : G) : G.norm (conjG z) = G.norm z := by
  cases z with
  | mk a b =>
    simp [G.norm, conjG]

/-- Multiplication by `i` cycles the four distinguished powers. -/
theorem G.iPow0_mul_i : G.iPow0 * i = G.iPow1 := by decide

theorem G.iPow1_mul_i : G.iPow1 * i = G.iPow2 := by decide

theorem G.iPow2_mul_i : G.iPow2 * i = G.iPow3 := by decide

theorem G.iPow3_mul_i : G.iPow3 * i = G.iPow0 := by decide

/-- The quarter-turn action preserves the Gaussian norm. -/
theorem G.norm_rotate90 (z : G) : G.norm (G.rotate90 z) = G.norm z := by
  cases z with
  | mk a b =>
    simp [G.norm, G.rotate90, i] <;> ring
#print axioms G.ringEquivGaussianInt
#print axioms G.rotate360_eq_self
#print axioms G.norm_rotate90
