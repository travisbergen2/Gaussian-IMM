import Mathlib

/-!
# CyclotomicFrobenius — σ_p is the arithmetic Frobenius in ℚ(ζₙ)

Generic over n. For a prime p ∤ n and a prime P of 𝓞 ℚ(ζₙ) above p, let σ_p ∈ Gal(ℚ(ζₙ)/ℚ) be
the automorphism with σ_p(ζₙ) = ζₙᵖ (`sigmaP`). Then:

* `sigmaP_isArithFrobAt`: σ_p is an arithmetic Frobenius at P in Mathlib's sense
  (`IsArithFrobAt ℤ σ_p P`: σ_p x ≡ xᵖ mod P for every x ∈ 𝓞 K);
* `stabilizer_eq_zpowers`: the decomposition group of P is generated by σ_p.

Proof: Mathlib supplies some Frobenius φ at P (`arithFrobAt`); a Frobenius sends roots of unity
of order prime to p to their p-th powers (`apply_of_pow_eq_one`), so φ(ζ) = ζᵖ, hence φ = σ_p.
No project imports.
-/

open NumberField IsCyclotomicExtension IsCyclotomicExtension.Rat Ideal MulAction

open scoped Pointwise

namespace CycloFrob

variable (n : ℕ) [NeZero n] (K : Type*) [Field K] [NumberField K] [IsCyclotomicExtension {n} ℚ K]

/-- σ_p: the automorphism with σ_p(ζₙ) = ζₙᵖ. -/
noncomputable def sigmaP (p : ℕ) (hn : p.Coprime n) : Gal(K/ℚ) :=
  (galEquivZMod n K).symm (ZMod.unitOfCoprime p hn)

variable {n K}
variable (p : ℕ) [hp : Fact (Nat.Prime p)] (P : Ideal (𝓞 K)) [P.IsMaximal]
  [P.LiesOver (Ideal.span {(p : ℤ)})] (hn : p.Coprime n)

theorem card_under : Nat.card (ℤ ⧸ P.under ℤ) = p := by
  rw [← (LiesOver.over : Ideal.span {(p : ℤ)} = P.under ℤ), Int.card_ideal_quot]

include hp hn in
theorem natCast_notMem : ((n : ℕ) : 𝓞 K) ∉ P := by
  intro h
  have h' : ((n : ℕ) : ℤ) ∈ P.under ℤ := by simpa using h
  rw [← (LiesOver.over : Ideal.span {(p : ℤ)} = P.under ℤ), Ideal.mem_span_singleton] at h'
  have : p ∣ n := Int.natCast_dvd_natCast.mp h'
  exact hp.out.one_lt.ne' (Nat.Coprime.eq_one_of_dvd hn this)

/-- **σ_p is an arithmetic Frobenius at P.** -/
theorem sigmaP_isArithFrobAt : IsArithFrobAt ℤ (sigmaP n K p hn) P := by
  have : IsGalois ℚ K := IsCyclotomicExtension.isGalois {n} ℚ K
  have hφ := IsArithFrobAt.arithFrobAt ℤ Gal(K/ℚ) P
  set φ := arithFrobAt ℤ Gal(K/ℚ) P
  have hζ := IsCyclotomicExtension.zeta_spec n ℚ K
  set z : 𝓞 K := hζ.toInteger
  have hz : z ^ n = 1 := hζ.toInteger_isPrimitiveRoot.pow_eq_one
  have h1 : φ • z = z ^ p := by
    have := hφ.apply_of_pow_eq_one hz (natCast_notMem p P hn)
    rwa [card_under p P] at this
  have h2 : φ • z = z ^ (galEquivZMod n K φ).val.val := galEquivZMod_smul_of_pow_eq n K φ hz
  have heq : galEquivZMod n K φ = ZMod.unitOfCoprime p hn := by
    apply Units.ext
    rw [ZMod.coe_unitOfCoprime, ← ZMod.natCast_zmod_val ((galEquivZMod n K φ : ZMod n)),
      ZMod.natCast_eq_natCast_iff']
    have hpm : z ^ p = z ^ (p % n) := by
      conv_lhs => rw [← Nat.mod_add_div p n]
      rw [pow_add, pow_mul, hz, one_pow, mul_one]
    have hval := hζ.toInteger_isPrimitiveRoot.pow_inj (ZMod.val_lt _) (Nat.mod_lt _ (NeZero.pos n))
      (h2.symm.trans (h1.trans hpm))
    rw [Nat.mod_eq_of_lt (ZMod.val_lt _)]
    exact hval
  have : φ = sigmaP n K p hn := by
    rw [sigmaP, ← heq, MulEquiv.symm_apply_apply]
  rw [← this]
  exact hφ

/-- **The decomposition group of P is generated by σ_p** (Mathlib's `galEquivZMod_stabilizer`,
transported back along `galEquivZMod`). -/
theorem stabilizer_eq_zpowers :
    stabilizer Gal(K/ℚ) P = Subgroup.zpowers (sigmaP n K p hn) := by
  have h := galEquivZMod_stabilizer n K p P hn
  calc stabilizer Gal(K/ℚ) P
      = (galEquivZMod n K).symm.mapSubgroup
          ((galEquivZMod n K).mapSubgroup (stabilizer Gal(K/ℚ) P)) := by
        ext σ; simp
    _ = (galEquivZMod n K).symm.mapSubgroup (Subgroup.zpowers (ZMod.unitOfCoprime p hn)) := by
        rw [h]
    _ = Subgroup.zpowers (sigmaP n K p hn) := by
        ext σ; simp [sigmaP, Subgroup.mem_zpowers_iff]

end CycloFrob

#print axioms CycloFrob.sigmaP_isArithFrobAt
#print axioms CycloFrob.stabilizer_eq_zpowers
