import CubicRadicandReconstruction

/-!
# CubicKroneckerWeber — every cyclic cubic field in ℂ lies in some ℚ(ζ_N) ⊆ ℂ

Everything happens inside the single ambient field ℂ: K is an intermediate field of ℂ/ℚ, and
`Cyc N = ℚ(e^{2πi/N})` is the intermediate field of ℂ generated by e^{2πi/N}, which is a
cyclotomic extension of ℚ (`IsCyclotomicExtension {N} ℚ (Cyc N)`).
* `Cyc_le_mul`: ℚ(ζ_a) ⊆ ℚ(ζ_{ab}) (ζ_{ab}^b = ζ_a); `InCyc x`: x lies in some ℚ(ζ_N); closed
  under products, inverses and finite products;
* `F_le_cyc3`: ℚ(ω) = ℚ(ζ₃); `ζ₉_mem`: ζ₉ ∈ ℚ(ζ₉);
* `gaussSum_inCyc`: a cubic Gauss sum over q (values χ(a) ∈ μ₃, ψ(a) = ζ^a with ζ ∈ μ_q) lies
  in ℚ(ζ_{3q});
* `cubic_kronecker_weber`: with the explicit cube root of `CubicRecon.radicand_cube_root`,
  s³β³ = A = γ³ with γ = ζ₉^j · Y · ∏ gᵢ, so sβ/γ is a cube root of unity, β = ω^i γ / s lies in
  a cyclotomic field, and K ⊆ K(ω) = ℚ(ω, β) ⊆ ℚ(ζ_N).
This is the reverse direction (cyclic cubic field ⇒ cyclotomic containment). The level N
produced is a multiple of the conductor, not the conductor itself.
-/

open IntermediateField Module NumberField CubicKummerRep CubicVal CubicRecon

namespace CubicKW

local notation "ω" => CubicAssembly.ω

/-- ζ_N = e^{2πi/N}. -/
noncomputable abbrev Z (n : ℕ) : ℂ := Complex.exp (2 * Real.pi * Complex.I / n)

/-- ℚ(ζ_N) as an intermediate field of ℂ. -/
noncomputable abbrev Cyc (n : ℕ) : IntermediateField ℚ ℂ := ℚ⟮Z n⟯

theorem Z_pow (a b : ℕ) (ha : a ≠ 0) (hb : b ≠ 0) : Z (a * b) ^ b = Z a := by
  rw [Z, Z, ← Complex.exp_nat_mul]
  congr 1
  push_cast
  field_simp

theorem Cyc_le_mul (a b : ℕ) (ha : a ≠ 0) (hb : b ≠ 0) : Cyc a ≤ Cyc (a * b) := by
  rw [Cyc, adjoin_simple_le_iff, ← Z_pow a b ha hb]
  exact pow_mem (mem_adjoin_simple_self ℚ _) b

theorem isCyclotomic (N : ℕ) [NeZero N] : IsCyclotomicExtension {N} ℚ (Cyc N) :=
  (Complex.isPrimitiveRoot_exp N (NeZero.ne N)).intermediateField_adjoin_isCyclotomicExtension ℚ

/-- x lies in some cyclotomic field ℚ(ζ_N) ⊆ ℂ. -/
def InCyc (x : ℂ) : Prop := ∃ n, 0 < n ∧ x ∈ Cyc n

theorem inCyc_mul {x y : ℂ} (hx : InCyc x) (hy : InCyc y) : InCyc (x * y) := by
  obtain ⟨a, ha, hxa⟩ := hx
  obtain ⟨b, hb, hyb⟩ := hy
  refine ⟨a * b, Nat.mul_pos ha hb, mul_mem (Cyc_le_mul a b ha.ne' hb.ne' hxa) ?_⟩
  rw [mul_comm]; exact Cyc_le_mul b a hb.ne' ha.ne' hyb

theorem inCyc_inv {x : ℂ} (hx : InCyc x) : InCyc x⁻¹ := by
  obtain ⟨a, ha, hxa⟩ := hx; exact ⟨a, ha, inv_mem hxa⟩

theorem inCyc_pow {x : ℂ} (hx : InCyc x) (k : ℕ) : InCyc (x ^ k) := by
  obtain ⟨a, ha, hxa⟩ := hx; exact ⟨a, ha, pow_mem hxa k⟩

theorem inCyc_list_prod : ∀ l : List ℂ, (∀ x ∈ l, InCyc x) → InCyc l.prod
  | [], _ => ⟨1, one_pos, by rw [List.prod_nil]; exact one_mem _⟩
  | x :: l, h => by
    rw [List.prod_cons]
    exact inCyc_mul (h x (by simp)) (inCyc_list_prod l (fun y hy => h y (by simp [hy])))

theorem ω_eq : ω = Z 3 := by simp [Z, CubicAssembly.ω]

/-- **ℚ(ω) = ℚ(ζ₃).** -/
theorem F_le_cyc3 : F ≤ Cyc 3 := by
  rw [F, adjoin_simple_le_iff, ω_eq]; exact mem_adjoin_simple_self ℚ _

theorem ω_mem : ω ∈ Cyc 3 := F_le_cyc3 (mem_adjoin_simple_self ℚ ω)

theorem inCyc_of_F {x : ℂ} (hx : x ∈ F) : InCyc x := ⟨3, by norm_num, F_le_cyc3 hx⟩

theorem ζ₉_mem : InCyc ζ₉ :=
  ⟨9, by norm_num, by rw [show ζ₉ = Z 9 by simp [Z, ζ₉]]; exact mem_adjoin_simple_self ℚ _⟩

/-- **Cubic Gauss sums are cyclotomic:** g ∈ ℚ(ζ_{3q}). -/
theorem gaussSum_inCyc {g : ℂ} (hg : IsGaussSum g) : InCyc g := by
  obtain ⟨q, hqF, -, χ, hχ, ζ, hζ, rfl⟩ := hg
  have hq0 : 0 < q := hqF.out.pos
  have hζmem : ζ ∈ Cyc q := by
    obtain ⟨i, -, hi⟩ :=
      (Complex.isPrimitiveRoot_exp q hq0.ne').eq_pow_of_pow_eq_one hζ.pow_eq_one
    rw [← hi]; exact pow_mem (mem_adjoin_simple_self ℚ _) i
  have hχmem : ∀ a, χ a ∈ Cyc (3 * q) := by
    intro a
    by_cases ha : IsUnit a
    · have h3 : (χ a) ^ 3 = 1 := by
        rw [← MulChar.pow_apply' _ (by norm_num), ← hχ, pow_orderOf_eq_one, MulChar.one_apply ha]
      obtain ⟨i, -, hi⟩ := CubicAssembly.hω.eq_pow_of_pow_eq_one h3
      rw [← hi]
      exact pow_mem (Cyc_le_mul 3 q (by norm_num) hq0.ne' ω_mem) i
    · rw [MulChar.map_nonunit _ ha]; exact zero_mem _
  refine ⟨3 * q, by omega, ?_⟩
  rw [gaussSum]
  refine sum_mem (fun a _ => mul_mem (hχmem a) ?_)
  rw [AddChar.zmodChar_apply]
  refine pow_mem ?_ _
  rw [mul_comm]; exact Cyc_le_mul q 3 hq0.ne' (by norm_num) hζmem

/-- **Cyclic cubic Kronecker–Weber:** a cyclic cubic field K ⊆ ℂ is contained in ℚ(ζ_N) ⊆ ℂ for
some N ≥ 1 (the same ambient ℂ; ℚ(ζ_N) is a cyclotomic extension of ℚ). -/
theorem cubic_kronecker_weber (K : IntermediateField ℚ ℂ) [IsGalois ℚ K]
    (hK : finrank ℚ K = 3) :
    ∃ N : ℕ, 0 < N ∧ K ≤ ℚ⟮Complex.exp (2 * Real.pi * Complex.I / N)⟯ ∧
      IsCyclotomicExtension {N} ℚ ℚ⟮Complex.exp (2 * Real.pi * Complex.I / N)⟯ := by
  obtain ⟨β, -, -, -, hM, s, A, hs0, hA0, hsA, j, Y, gs, hgs, hAeq⟩ := radicand_cube_root K hK
  set γ := ζ₉ ^ j * ι Y * gs.prod with hγdef
  have hγ : InCyc γ :=
    inCyc_mul (inCyc_mul (inCyc_pow ζ₉_mem j) (inCyc_of_F (Y : F).2))
      (inCyc_list_prod gs (fun g hg => gaussSum_inCyc (hgs g hg)))
  have hιs0 : ι s ≠ 0 := (map_ne_zero_iff _ ι_injective).mpr hs0
  have hγ0 : γ ≠ 0 := by
    intro h
    rw [h, zero_pow (by norm_num)] at hAeq
    exact hA0 (ι_injective (by rw [hAeq, map_zero]))
  -- s β / γ is a cube root of unity
  have hratio : (ι s * β / γ) ^ 3 = 1 := by
    rw [div_pow, mul_pow, hsA, hAeq, div_self (pow_ne_zero _ hγ0)]
  obtain ⟨i, -, hi⟩ := CubicAssembly.hω.eq_pow_of_pow_eq_one hratio
  have hβeq : β = ω ^ i * γ * (ι s)⁻¹ := by
    rw [hi]; field_simp
  have hβ : InCyc β := by
    rw [hβeq]
    exact inCyc_mul (inCyc_mul (inCyc_pow ⟨3, by norm_num, ω_mem⟩ i) hγ)
      (inCyc_inv (inCyc_of_F (s : F).2))
  obtain ⟨n, hn, hβn⟩ := hβ
  have : NeZero (3 * n) := ⟨by omega⟩
  refine ⟨3 * n, by omega, ?_, isCyclotomic (3 * n)⟩
  calc K ≤ M K := le_sup_left
    _ = ℚ⟮ω, β⟯ := hM
    _ ≤ Cyc (3 * n) := by
      rw [adjoin_le_iff]
      intro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with rfl | rfl
      · exact Cyc_le_mul 3 n (by norm_num) hn.ne' ω_mem
      · rw [mul_comm]; exact Cyc_le_mul n 3 hn.ne' (by norm_num) hβn

end CubicKW

#print axioms CubicKW.gaussSum_inCyc
#print axioms CubicKW.cubic_kronecker_weber
